# Local-only override for `make up-local` (docker compose --env-file .env.local
# --profile minio). Dummy secrets, local MinIO bucket — never points at the
# real Cloudflare R2 bucket or real production credentials.
# Copy to .env.local and adjust if needed; safe to commit weak secrets here.

JWT_SECRET=dev-local-secret-not-for-prod-min-32-chars
FRONTEND_URL=http://localhost:4321
CORS_ORIGINS=http://localhost:4321,http://localhost:5173
NODE_ENV=development

PUBLIC_BFF_URL=http://localhost:3001
PUBLIC_SPA_URL=http://localhost:5173
VITE_BFF_URL=http://localhost:3001

# Contact form — leave empty locally, submissions just log instead of sending.
RESEND_API_KEY=
CONTACTO_FROM_EMAIL=web@elhornero.org
CONTACTO_TO_EMAIL=consultas@elhornero.org
TURNSTILE_SECRET=

MINIO_ROOT_USER=hornero
MINIO_ROOT_PASSWORD=hornero-minio-local

DB_NAME=hornero
DB_USERNAME=hornero
DB_PASSWORD=hornero
POSTGRES_DB=hornero
POSTGRES_USER=hornero
POSTGRES_PASSWORD=hornero
