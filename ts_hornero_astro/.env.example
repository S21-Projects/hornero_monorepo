# Server-side: internal BFF URL the Astro server fetches public data from (no /api prefix)
BFF_BASE_URL=http://localhost:3001
# Client-side: BFF URL used in the browser for public image GETs
PUBLIC_BFF_URL=http://localhost:3001
# Client-side: origin of the authenticated SPA, used for "donate"/"login" CTA deep-links
PUBLIC_SPA_URL=http://localhost:5173
