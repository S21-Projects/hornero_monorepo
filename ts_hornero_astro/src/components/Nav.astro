---
const spaUrl = import.meta.env.PUBLIC_SPA_URL ?? '#';
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/organizaciones', label: 'Organizaciones' },
  { href: '/necesidades', label: 'Necesidades' },
  { href: '/mapa', label: 'Mapa' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];

function linkClass(href: string) {
  const active = currentPath === href;
  const base =
    'block rounded-lg px-3 py-2 text-sm font-bold no-underline transition-colors';
  return active
    ? `${base} text-[var(--horn)] bg-[var(--straw)]`
    : `${base} text-[var(--ink-2)] hover:bg-[var(--card-2)]`;
}
---

<header
  class="sticky top-0 z-[100] border-b border-[var(--line)] bg-[var(--card)] shadow-[var(--sh-1)]"
>
  <nav
    class="mx-auto flex h-[60px] max-w-[1200px] items-center justify-between gap-4 px-4 sm:px-6"
  >
    <!-- Logo / wordmark -->
    <a
      href="/"
      class="inline-flex flex-shrink-0 items-center gap-2 no-underline"
      aria-label="El Hornero — Inicio"
    >
      <img
        src="/icon.svg"
        alt="El Hornero"
        class="block h-10 w-10 object-contain sm:hidden"
        data-img-fallback="#logo-fallback:inline-flex"
      />
      <img
        src="/logo_filled.svg"
        alt="El Hornero — Comedores Córdoba"
        class="hidden h-11 w-auto object-contain sm:block"
        data-img-fallback="#logo-fallback:inline-flex"
      />
      <span
        id="logo-fallback"
        class="hidden items-center gap-1.5 text-base font-black tracking-tight text-[var(--horn)] sm:text-lg"
        style="display:none"
      >
        🦅 El Hornero
      </span>
    </a>

    <!-- Desktop nav links -->
    <ul class="m-0 hidden list-none items-center gap-1 p-0 sm:flex">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={currentPath === href ? 'page' : undefined}
            class={linkClass(href)}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <!-- CTA — deep-links to the SPA for login/donate (desktop) -->
      <a
        href={spaUrl}
        class="hidden whitespace-nowrap rounded-[var(--r-btn)] bg-[var(--horn)] px-4 py-2 text-sm font-extrabold text-white no-underline shadow-[0_2px_0_#A8481699] transition-[filter] hover:brightness-105 sm:inline-block"
      >
        Donar / Ingresar
      </a>

      <!-- Hamburger — mobile only -->
      <button
        id="nav-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-2xl leading-none text-[var(--ink-2)] sm:hidden"
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu (toggled by the hamburger) -->
  <div
    id="mobile-menu"
    class="hidden border-t border-[var(--line)] bg-[var(--card)] px-4 py-3 sm:hidden"
  >
    <ul class="m-0 flex list-none flex-col gap-1 p-0">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={currentPath === href ? 'page' : undefined}
            class={linkClass(href)}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href={spaUrl}
      class="mt-3 block rounded-[var(--r-btn)] bg-[var(--horn)] px-4 py-2.5 text-center text-sm font-extrabold text-white no-underline shadow-[0_2px_0_#A8481699]"
    >
      Donar / Ingresar
    </a>
  </div>
</header>

<script is:inline>
  // Image fallback without inline `onerror` attributes (they would need 'unsafe-inline' in the CSP):
  // an <img data-img-fallback="<target>:<display>"> is hidden and its target shown when it fails.
  // <target> is a CSS selector, or `next` for the following sibling.
  (function () {
    function fallback(img) {
      var spec = img.getAttribute('data-img-fallback');
      if (!spec) return;
      var cut = spec.lastIndexOf(':');
      var target = spec.slice(0, cut);
      var el = target === 'next' ? img.nextElementSibling : document.querySelector(target);
      img.style.display = 'none';
      if (el) el.style.display = spec.slice(cut + 1);
    }
    // `error` does not bubble but can be captured on the document.
    document.addEventListener('error', function (e) {
      if (e.target && e.target.tagName === 'IMG') fallback(e.target);
    }, true);
    // Images that already failed before this script ran.
    document.querySelectorAll('img[data-img-fallback]').forEach(function (img) {
      if (img.complete && img.naturalWidth === 0) fallback(img);
    });
  })();
  (function () {
    var btn = document.getElementById('nav-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    var icon = btn.querySelector('span');
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.setAttribute('aria-label', expanded ? 'Abrir menú' : 'Cerrar menú');
      menu.classList.toggle('hidden');
      if (icon) icon.textContent = expanded ? '☰' : '✕';
    });
  })();
</script>
