---
import Layout from '../layouts/Layout.astro';
import { Text } from '../components/ui/typography';
import { Button } from '../components/ui/button';
---

<Layout
  title="Página no encontrada — El Hornero"
  description="La página que buscás no existe o ya no está disponible."
>
  <div
    class="flex min-h-[60vh] flex-col items-center justify-center gap-1.5 px-6 py-10 text-center"
  >
    <div
      class="mb-4 flex h-[72px] w-[72px] items-center justify-center rounded-[20px]"
      style="background: var(--sky-bg);"
    >
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="var(--sky)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
      </svg>
    </div>
    <Text variant="display" color="horn">404</Text>
    <Text variant="h2" as="h1" style={{ marginTop: '8px' }}>
      Página no encontrada
    </Text>
    <Text variant="body" color="ink-2" style={{ maxWidth: '360px', marginTop: '8px' }}>
      Puede que el enlace esté roto o la página ya no esté disponible.
    </Text>
    <a href="/" style="margin-top: 24px; text-decoration: none;">
      <Button variant="primary">Volver al inicio</Button>
    </a>
  </div>
</Layout>
