---
import Layout from '../layouts/Layout.astro';
import HomeMapExplorer from '../components/islands/HomeMapExplorer';
import { publicFetch } from '../lib/publicFetch';
import type { Org, PageData } from '../lib/types';

let orgs: Org[] = [];
try {
  // TODO [tech-debt]: no UI pager yet, fixed size=50 ceiling
  const page = await publicFetch<PageData<Org>>('/organizaciones?size=50');
  orgs = page.content;
} catch (e) {
  // BFF unavailable at build time or runtime — render with empty list
  orgs = [];
}
---

<Layout title="El Hornero — Comedores Córdoba">
  <HomeMapExplorer client:only="react" orgs={orgs} />
</Layout>
