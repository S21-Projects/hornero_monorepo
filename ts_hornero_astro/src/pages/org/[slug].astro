---
import Layout from '../../layouts/Layout.astro';
import LocationMap from '../../components/islands/LocationMap';
import { publicFetch } from '../../lib/publicFetch';
import { Card } from '../../components/ui/card';
import { Pill } from '../../components/ui/pill';
import { Avatar } from '../../components/ui/avatar';
import { Text } from '../../components/ui/typography';
import { TIPO_ORGANIZACION_LABELS, type TipoOrganizacion } from '../../lib/tipos-organizacion';
import type { Org, Necesidad, Donacion } from '../../lib/types';

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404 });
}

// Three sequential reads — sequential is acceptable for slice 1.
let org: Org | null = null;
let needs: Necesidad[] = [];
let donations: Donacion[] = [];

try {
  // TODO: when the MS pagination/envelope cutover lands, switch to PageResponse<T> and read .content (see src/lib/types.ts)
  org = await publicFetch<Org>(`/organizaciones/${encodeURIComponent(slug)}`);
} catch {
  return new Response(null, { status: 404 });
}

if (!org) {
  return new Response(null, { status: 404 });
}

try {
  // TODO: when the MS pagination/envelope cutover lands, switch to PageResponse<T> and read .content (see src/lib/types.ts)
  needs = await publicFetch<Necesidad[]>(`/necesidades?organizacionId=${org.id}`);
} catch {
  needs = [];
}

try {
  // TODO: when the MS pagination/envelope cutover lands, switch to PageResponse<T> and read .content (see src/lib/types.ts)
  donations = await publicFetch<Donacion[]>(`/donaciones?organizacionId=${org.id}`);
} catch {
  donations = [];
}

const PUBLIC_BFF_URL = import.meta.env.PUBLIC_BFF_URL ?? '';
const PUBLIC_SPA_URL = import.meta.env.PUBLIC_SPA_URL ?? '';

function mapPrioridad(prioridad: string): 'urgent' | 'medium' | 'normal' {
  const map: Record<string, 'urgent' | 'medium' | 'normal'> = {
    URGENTE: 'urgent',
    MEDIA: 'medium',
    NORMAL: 'normal',
  };
  return map[prioridad] ?? 'normal';
}

const PRIORITY_LABEL = { urgent: 'Urgente', medium: 'Media', normal: 'Normal' } as const;

const ESTADO_DONACION_LABELS: Record<string, string> = {
  OFRECIDA: 'Ofrecida',
  EN_CAMINO: 'En camino',
  ENTREGADA: 'Entregada',
  CANCELADA: 'Cancelada',
};

const ESTADO_DONACION_PILL: Record<string, 'warn' | 'open' | 'ok' | 'bad'> = {
  OFRECIDA: 'warn',
  EN_CAMINO: 'open',
  ENTREGADA: 'ok',
  CANCELADA: 'bad',
};
---

<Layout
  title={`${org.nombre} — El Hornero`}
  description={org.descripcion ?? `Conocé ${org.nombre}, organización de Córdoba.`}
>
  <div style={{ flex: 1, overflow: 'auto' }}>
    {/* hero */}
    <div class="relative h-[180px] bg-[var(--card-2)] sm:h-[240px]">
      {org.bannerKey && (
        <img
          src={`${PUBLIC_BFF_URL}/images?key=${org.bannerKey}`}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover"
        />
      )}
      <div
        class="absolute inset-0"
        style={{
          background: 'linear-gradient(180deg, rgba(200,90,32,.30) 0%, rgba(122,42,8,.82) 100%)',
        }}
      />
      <div
        class="absolute bottom-4 left-4 right-4 flex items-end gap-3 sm:bottom-6 sm:left-10 sm:right-10 sm:gap-5"
      >
        <div
          class="flex h-16 w-16 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl border-[3px] border-white shadow-[var(--sh-2)] sm:h-24 sm:w-24 sm:rounded-2xl"
          style={{ background: '#F6ECDC' }}
        >
          {org.profileImageKey ? (
            <img
              src={`${PUBLIC_BFF_URL}/images?key=${org.profileImageKey}`}
              alt={`${org.nombre} profile`}
              class="h-full w-full object-cover"
            />
          ) : (
            <svg width={32} height={32} viewBox="0 0 24 24" fill="none" stroke="var(--horn)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 14c0-4 3-7 7-7 2 0 4 1 4 1l3-2-1 3s1 2 1 4c0 4-3 7-7 7" />
              <circle cx="10" cy="11" r="1" fill="var(--horn)" stroke="none" />
              <path d="M5 14c-1 2-2 3-3 3 1 1 3 1 4 0" />
            </svg>
          )}
        </div>
        <div class="min-w-0 flex-1 pb-1">
          <div class="mb-2 flex flex-wrap gap-2">
            <Pill variant="cat">{TIPO_ORGANIZACION_LABELS[org.tipo as TipoOrganizacion] ?? org.tipo}</Pill>
            <Pill variant="solid" style={{ background: 'rgba(255,255,255,.22)' }}>
              {org.validada ? 'Validado' : 'Pendiente'}
            </Pill>
            {org.aceptaDonaciones && (
              <Pill variant="solid" style={{ background: 'rgba(255,255,255,.22)' }}>
                Recibe donaciones
              </Pill>
            )}
          </div>
          <Text variant="h1" as="h1" className="text-2xl sm:text-[32px]" style={{ color: '#fff' }}>{org.nombre}</Text>
          <Text
            as="div"
            variant="body-sm"
            className="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 font-bold"
            style={{ opacity: 0.95, color: '#fff' }}
          >
            <span class="inline-flex min-w-0 items-center gap-1.5">
              <span aria-hidden="true">📍</span>
              <span class="truncate">{org.direccion ?? 'Sin dirección'}</span>
            </span>
          </Text>
        </div>
      </div>
    </div>

    {/* body */}
    <div class="flex flex-col gap-6 px-4 py-6 sm:flex-row sm:items-start sm:gap-7 sm:px-10 sm:py-7">
      <div class="flex min-w-0 flex-1 flex-col gap-5 sm:gap-[22px]">
        {/* about */}
        <Card className="p-5 sm:p-6">
          <Text variant="h3" as="h3" style={{ marginBottom: 6 }}>Sobre el comedor</Text>
          <Text variant="body" color="ink-2">
            {org.descripcion ?? ''}
          </Text>
          {(org.referenteEmail || org.sitioWebUrl) && (
            <div class="mt-[18px] flex flex-wrap gap-7">
              {org.referenteEmail && (
                <div class="flex items-center gap-[11px]">
                  <div class="flex h-10 w-10 items-center justify-center rounded-[11px]" style={{ background: 'var(--card-2)' }}>
                    ✉️
                  </div>
                  <div>
                    <Text as="div" variant="caption" color="ink-3">Contacto</Text>
                    <Text as="div" variant="body-sm">{org.referenteEmail}</Text>
                  </div>
                </div>
              )}
              {org.sitioWebUrl && (
                <div class="flex items-center gap-[11px]">
                  <div class="flex h-10 w-10 items-center justify-center rounded-[11px]" style={{ background: 'var(--card-2)' }}>
                    🌐
                  </div>
                  <div class="min-w-0">
                    <Text as="div" variant="caption" color="ink-3">Sitio web</Text>
                    <a
                      href={org.sitioWebUrl}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="truncate"
                      style={{ color: 'var(--sky)', fontWeight: 700, fontSize: 'var(--fs-body-sm)', textDecoration: 'none' }}
                    >
                      {org.sitioWebUrl}
                    </a>
                  </div>
                </div>
              )}
            </div>
          )}
        </Card>

        {needs.length > 0 && (
          <Card style={{ padding: '20px 24px 8px' }}>
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 4 }}>
              <Text variant="h3" as="h3">Necesidades activas</Text>
              <Pill variant="ghost">{needs.length} abiertas</Pill>
            </div>
            {needs.map((n) => {
              const priority = mapPrioridad(n.prioridad);
              return (
                <div class="flex items-center gap-4 py-4" style={{ borderBottom: '1px solid var(--line-soft)' }}>
                  <div style={{ width: 44, height: 44, borderRadius: 12, background: 'var(--card-2)', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    📦
                  </div>
                  <div style={{ flex: 1, minWidth: 0 }}>
                    <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                      <Text variant="body" as="h4">{n.descripcion}</Text>
                      <Pill variant={priority}>{PRIORITY_LABEL[priority]}</Pill>
                    </div>
                    <Text variant="label" as="p" color="ink-2" style={{ marginTop: 4 }}>{n.estado}</Text>
                  </div>
                  {/* DonateButton removed — CTA deep-links to authenticated SPA */}
                  <a
                    href={`${PUBLIC_SPA_URL}/donaciones?orgSlug=${org.slug}&returnTo=/org/${org.slug}`}
                    style={{ fontSize: 13, fontWeight: 700, color: 'var(--sky)', textDecoration: 'none', flexShrink: 0 }}
                  >
                    Donar
                  </a>
                </div>
              );
            })}
          </Card>
        )}

        {donations.length > 0 && (
          <Card style={{ padding: '20px 24px 8px' }}>
            <Text variant="h3" as="h3" style={{ marginBottom: 4 }}>Donaciones recientes</Text>
            {donations.map((d) => (
              <div class="flex items-center gap-3.5 py-3.5" style={{ borderBottom: '1px solid var(--line-soft)' }}>
                <Avatar name={d.donanteName} size={40} tintIndex={d.donanteName.length % 6} />
                <div style={{ flex: 1, minWidth: 0 }}>
                  <Text as="div" variant="body-sm">{d.donanteName}</Text>
                  <Text as="div" variant="label" color="ink-2">{d.observaciones ?? ''}</Text>
                </div>
                <Text as="div" variant="caption" color="ink-3" style={{ marginRight: 8 }}>{d.fechaOferta}</Text>
                <Pill variant={ESTADO_DONACION_PILL[d.estado] ?? 'ghost'} dot>
                  {ESTADO_DONACION_LABELS[d.estado] ?? d.estado}
                </Pill>
              </div>
            ))}
          </Card>
        )}
      </div>

      {/* right rail */}
      <div class="flex w-full flex-col gap-4 sm:w-[320px] sm:flex-shrink-0 sm:gap-[18px]">
        {/* CTA to SPA — replaces DonateButton */}
        <Card style={{ padding: 22, background: 'var(--straw)' }}>
          <Text variant="h3" as="h3" style={{ marginBottom: 8 }}>¿Querés colaborar?</Text>
          <Text variant="body-sm" color="ink-2" style={{ marginBottom: 14 }}>
            Ingresá a la plataforma para ver las necesidades activas y hacer tu donación.
          </Text>
          <a
            href={`${PUBLIC_SPA_URL}/donaciones?orgSlug=${org.slug}&returnTo=/org/${org.slug}`}
            style={{
              display: 'block',
              textAlign: 'center',
              padding: '12px 20px',
              background: 'var(--earth)',
              color: '#fff',
              borderRadius: 'var(--r-btn)',
              fontWeight: 800,
              fontSize: 15,
              textDecoration: 'none',
            }}
          >
            Ir a donar
          </a>
          {org.donacionDirectaUrl && (
            <>
              <a
                href={org.donacionDirectaUrl}
                target="_blank"
                rel="noopener noreferrer nofollow"
                style={{
                  display: 'block',
                  textAlign: 'center',
                  marginTop: 10,
                  padding: '10px 20px',
                  background: 'transparent',
                  color: 'var(--earth)',
                  border: '1.5px solid var(--earth)',
                  borderRadius: 'var(--r-btn)',
                  fontWeight: 700,
                  fontSize: 14,
                  textDecoration: 'none',
                }}
              >
                Donar directo a la organización
              </a>
              <Text variant="caption" color="ink-3" style={{ marginTop: 6 }}>
                Este canal lo administra la organización — El Hornero no interviene ni hace seguimiento.
              </Text>
            </>
          )}
        </Card>

        <Card style={{ padding: 20 }}>
          <Text variant="title" as="h4" style={{ marginBottom: 12 }}>Ubicación</Text>
          {org.latitud != null && org.longitud != null ? (
            <div style={{ borderRadius: 14, overflow: 'hidden', height: 150 }}>
              <LocationMap client:only="react" lat={org.latitud} lng={org.longitud} label={org.nombre} height={150} />
            </div>
          ) : (
            <Text variant="body" color="ink-2">
              {org.direccion ?? 'Ubicación no disponible'}
            </Text>
          )}
        </Card>
      </div>
    </div>
  </div>
</Layout>
