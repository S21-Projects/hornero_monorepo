---
import Layout from '../layouts/Layout.astro';
import OrgList from '../components/islands/OrgList';
import { ErrorState } from '../components/ui/error-state';
import { publicFetchSafe } from '../lib/publicFetch';
import type { Org, PageData } from '../lib/types';

// TODO [tech-debt]: no UI pager yet, fixed size=50 ceiling
const result = await publicFetchSafe<PageData<Org>>('/organizaciones?size=50');
---

<Layout
  title="Organizaciones — El Hornero"
  description="Listado de comedores y organizaciones validadas de Córdoba."
>
  <div class="flex-1 overflow-auto px-4 py-7 sm:px-10">
    {
      result.ok ? (
        <OrgList client:load orgs={result.data.content} />
      ) : (
        <ErrorState
          title="No pudimos cargar las organizaciones"
          message="Ocurrió un error al conectar con el servidor. Intentá de nuevo más tarde."
        />
      )
    }
  </div>
</Layout>
