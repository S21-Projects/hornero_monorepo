# -------------------------------------------------------
# Hornero — root environment template
# Copy to .env and fill in your values before running.
# DO NOT commit .env — it contains real secrets.
# -------------------------------------------------------

# Spring Boot microservice
SERVER_PORT=8081
JWT_SECRET=change-me-use-a-long-random-secret-min-32-chars

# NestJS BFF
BFF_PORT=3001
FRONTEND_URL=http://localhost:3000

# Next.js frontend
APP_PORT=3000
# NEXT_PUBLIC_* is baked into the browser bundle at build time.
# When running via Docker Compose this is passed as a build-arg.
NEXT_PUBLIC_BFF_URL=http://localhost:3001
