# Root .env consumed by docker-compose.yml — one file for the whole stack
# (postgres, ms, bff, astro, admin, and the opt-in minio/tunnel profiles).
# Local dev and the Pi deploy both read this same file; only the values differ.

# ── Shared ────────────────────────────────────────────────────────────────
# Must match between MS and BFF
# Min 32 random chars. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-use-a-long-random-secret-min-32-chars

# ── MS ────────────────────────────────────────────────────────────────
SERVER_PORT=8081
OTP_FROM_EMAIL=no-reply@elhornero.org
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
RESEND_API_KEY=

# ── BFF ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4321
CORS_ORIGINS=http://localhost:4321,http://localhost:5173
NODE_ENV=production

# ── Fronts ────────────────────────────────────────────────────────────────
# Changing these requires `docker compose build`, not just a restart.
PUBLIC_BFF_URL=http://localhost:3001
PUBLIC_SPA_URL=http://localhost:5173
VITE_BFF_URL=http://localhost:3001

# ── Astro ────────────────────────────────────────────────────────────────
CONTACTO_FROM_EMAIL=web@elhornero.org
CONTACTO_TO_EMAIL=consultas@elhornero.org
TURNSTILE_SECRET=

# ── Object storage — S3-compatible bucket for org images ──────────────────────
AWS_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_BUCKET_NAME=hornero-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hornero
DB_USERNAME=hornero
DB_PASSWORD=hornero

POSTGRES_DB=hornero
POSTGRES_USER=hornero
POSTGRES_PASSWORD=hornero

# ── Optionals, all with default values ────────────────────────────────────────────────────────────────
# SEED_DEMO_DATA=false
# UPLOAD_MAX_MB=5
# EVIDENCIA_RETENCION_ENABLED=false
# EVIDENCIA_RETENCION_MESES=12
# EVIDENCIA_RETENCION_MAX=100
# EVIDENCIA_RETENCION_CRON=0 30 4 * * *
# MAIL_FROM_EMAIL=
# MAIL_LOG_ONLY=false
# APP_PANEL_URL=http://localhost:5173
# PASSWORD_RESET_TTL_MINUTOS=30
# NOTIFICACIONES_ENABLED=true
# NOTIFICACIONES_DIGEST_CRON=0 0 8 * * *
# CSP_MODE=report-only
# DONANTE_PUBLICO=false
# DONACIONES_OFERTA_SIN_RESPUESTA_DIAS=7
# DONACIONES_PROPUESTA_SIN_RESPUESTA_DIAS=3
# DONACIONES_EN_CURSO_ESTANCADA_DIAS=14
# DONACIONES_CONFIRMACION_ESTANCADA_DIAS=7
# DONACIONES_ESTANCADAS_CRON=0 15 0 * * *
# RONDAS_AUTO_ENABLED=false
# RONDAS_AUTO_CRON=0 0 6 * * *
# IDEMPOTENCIA_TTL_HORAS=24
# ACTIVIDAD_RETENCION_DIAS=365
# ACTIVIDAD_EMAIL_INTENTO_DIAS=90
# DATOS_COORDENADAS_PRECISAS_DIAS=30
# BACKUP_RETENTION_DAYS=14
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# BACKUP_PASSPHRASE=
# BACKUP_S3_PREFIX=hornero/

# ─────────────────────────────── Optional settings ───────────────────────────────
NOSOTROS_ENABLED=false