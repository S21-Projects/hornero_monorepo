# ── Shared ────────────────────────────────────────────────────────────────────
# Must match between MS and BFF. Min 32 random chars.
JWT_SECRET=change-me-use-a-long-random-secret-min-32-chars

# ── MS (jar_hornero_ms) ───────────────────────────────────────────────────────
SERVER_PORT=8081

# ── BFF (ts_hornero_bff) ──────────────────────────────────────────────────────
PORT=3001
JAVA_MS_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000

# ── App (ts_hornero_app) ──────────────────────────────────────────────────────
# Baked into the Next.js bundle at build time — restart dev server after changing.
NEXT_PUBLIC_BFF_URL=http://localhost:3001
# Server-side internal URL used by Server Components / loaders (publicFetch,
# serverFetch). Read at request time, NOT baked into the bundle.
# Local dev: http://localhost:3001 — Docker (make up): http://bff:3001
BFF_BASE_URL=http://localhost:3001

# ── Database (jar_hornero_ms) ─────────────────────────────────────────────────
# Local dev (make dev-ms): DB_HOST=localhost — Postgres must be running locally
# Docker (make up):        DB_HOST is hardcoded to 'postgres' in docker-compose.yml
#                          (these vars are still used by the postgres service itself)
# Railway:                 Set all vars in the Variables tab — same names
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hornero
DB_USERNAME=hornero
DB_PASSWORD=hornero

# Used by the postgres Docker service (make up only)
POSTGRES_DB=hornero
POSTGRES_USER=hornero
POSTGRES_PASSWORD=hornero
