# ── Shared ────────────────────────────────────────────────────────────────────
# Must match between MS and BFF. Min 32 random chars.
JWT_SECRET=change-me-use-a-long-random-secret-min-32-chars

# ── MS (jar_hornero_ms) ───────────────────────────────────────────────────────
SERVER_PORT=8081

# ── BFF (ts_hornero_bff) ──────────────────────────────────────────────────────
PORT=3001
JAVA_MS_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000

# ── App (ts_hornero_app) ──────────────────────────────────────────────────────
# Baked into the Next.js bundle at build time — restart dev server after changing.
NEXT_PUBLIC_BFF_URL=http://localhost:3001
