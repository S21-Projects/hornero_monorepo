# Root .env consumed by docker-compose.yml — one file for the whole stack
# (postgres, ms, bff, astro, admin, and the opt-in minio/tunnel profiles).
# Local dev and the Pi deploy both read this same file; only the values differ.

# ── Shared — must match between MS and BFF ────────────────────────────────────
# Min 32 random chars. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-use-a-long-random-secret-min-32-chars

# ── MS (jar_hornero_ms) ───────────────────────────────────────────────────────
SERVER_PORT=8081
# Mismo RESEND_API_KEY de la sección de Astro más abajo — el MS ahora también
# manda mail (OTP de verificación), reusa la misma cuenta de Resend.
OTP_FROM_EMAIL=otp-no-reply@elhornero.org

# ── BFF (ts_hornero_bff) — runtime env, read by the container at start ────────
FRONTEND_URL=http://localhost:4321
CORS_ORIGINS=http://localhost:4321,http://localhost:5173
NODE_ENV=production

# ── Fronts — baked into the bundle at BUILD time, not read at runtime ─────────
# Changing these requires `docker compose build`, not just a restart.
PUBLIC_BFF_URL=http://localhost:3001
PUBLIC_SPA_URL=http://localhost:5173
VITE_BFF_URL=http://localhost:3001

# ── Astro público (ts_hornero_astro) — contact form, runtime env ──────────────
RESEND_API_KEY=re_j41fsT58_AW2dnuRu7RNqfG9tbXRajV6s
CONTACTO_FROM_EMAIL=web@elhornero.org
CONTACTO_TO_EMAIL=consultas@elhornero.org
TURNSTILE_SECRET=

# ── Object storage — S3-compatible bucket for org images ──────────────────────
AWS_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_BUCKET_NAME=hornero-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Solo si optás por el bucket local en vez de R2: `docker compose --profile minio up`
# MINIO_ROOT_USER=hornero
# MINIO_ROOT_PASSWORD=change-me

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hornero
DB_USERNAME=hornero
DB_PASSWORD=hornero

POSTGRES_DB=hornero
POSTGRES_USER=hornero
POSTGRES_PASSWORD=hornero

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────────
# NO se lee de acá en la Pi: cloudflared corre como systemd en el host, no
# como el profile `tunnel` del compose (ver docs/deploy-rpi-cloudflare.md).
# TUNNEL_TOKEN=