@startuml
' Hornero — Diagrama de casos de uso
' CU-01 a CU-06 provienen de la entrega de analista.
' CU-07 a CU-19 incorporan acreditación progresiva, trazabilidad, asignación y reasignación.
' Vista consolidada; el detalle por actor está en los archivos hermanos.

!include _estilo.iuml

actor "Visitante\n(anónimo)" as Visitante
actor "Donante" as Donante
actor "Referente" as Referente
rectangle "Hornero" {
  usecase "CU-01\nRegistrar organización" as CU01
  usecase "CU-02\nValidar organización" as CU02
  usecase "CU-03\nPublicar necesidad" as CU03
  usecase "CU-04\nConsultar necesidades\nen el mapa" as CU04
  usecase "CU-05\nOfrecer donación" as CU05
  usecase "CU-06\nGestionar seguimiento\nde la organización" as CU06
  usecase "CU-07\nPresentar evidencia\nde acreditación" as CU07
  usecase "CU-08\nAuditar evidencia\npresentada" as CU08
  usecase "CU-09\nElevar o reducir\nnivel de acreditación" as CU09
  usecase "CU-10\nExportar legajo\nde acreditación" as CU10
  usecase "CU-11\nAsignar donaciones\ndel fondo común" as CU11
  usecase "CU-12\nVerificar correo\nelectrónico" as CU12
  usecase "CU-13\nValidar entrega con\ncódigo de un solo uso" as CU13
  usecase "CU-14\nAceptar o rechazar\ndonación recibida" as CU14
  usecase "CU-15\nVencer donaciones\nsin respuesta" as CU15
  usecase "CU-16\nReclamar organización\nimportada" as CU16
  usecase "CU-17\nResolver reclamo\nde organización" as CU17
  usecase "CU-18\nReportar organización" as CU18
  usecase "CU-19\nResolver reporte\nde organización" as CU19
  usecase "Devolver donación\nal fondo común" as Devolver
  usecase "Registrar evento\nen la bitácora" as Bitacora
  usecase "Verificar requisitos\ndel nivel" as VerificarReq
}

actor "Administrador" as Admin
actor "Planificador\n(tiempo)" as Planificador
actor "Motor de asignación\n(servicio interno)" as Motor

Visitante --> CU04
Visitante --> CU01

Donante --> CU05
Donante --> CU13
Donante --> CU04
Donante --> CU12
Donante --> CU18

Referente --> CU03
Referente --> CU06
Referente --> CU07
Referente --> CU12
Referente --> CU10
Referente --> CU13
Referente --> CU14
Referente --> CU16
Referente --> CU18

CU02 <-- Admin
CU08 <-- Admin
CU09 <-- Admin
CU10 <-- Admin
CU11 <-- Admin
CU17 <-- Admin
CU19 <-- Admin

CU11 <-- Planificador
CU15 <-- Planificador

CU11 --> Motor

CU02 ..> Bitacora : <<include>>
CU07 ..> Bitacora : <<include>>
CU08 ..> Bitacora : <<include>>
CU09 ..> Bitacora : <<include>>
CU09 ..> VerificarReq : <<include>>
CU11 ..> Bitacora : <<include>>
CU13 ..> Bitacora : <<include>>
CU14 ..> Bitacora : <<include>>
CU15 ..> Bitacora : <<include>>
CU17 ..> Bitacora : <<include>>
CU19 ..> Bitacora : <<include>>
CU05 ..> CU13 : <<include>>
CU03 ..> VerificarReq : <<include>>
CU05 ..> CU11 : <<extend>>\n(donación al fondo común)
Devolver ..> CU14 : <<extend>>\n(rechazo de una propuesta)
CU15 ..> Devolver : <<include>>

@enduml
