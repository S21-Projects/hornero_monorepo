# ── .env.local — local dev con Postgres en Docker ─────────────────────────────
# Uso: cp .env.local.example .env.local
# Arranca la DB:  make postgres-up
# Arranca el MS:  make dev-ms-local   (terminal 1)
# Arranca el BFF: make dev-bff-local  (terminal 2)
# Arranca la App: make dev-app-local  (terminal 3)

# Shared
JWT_SECRET=change-me-use-a-long-random-secret-min-32-chars

# MS
SERVER_PORT=8081

# BFF
PORT=3001
JAVA_MS_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000

# App
NEXT_PUBLIC_BFF_URL=http://localhost:3001

# Database — apunta al contenedor local (make postgres-up)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hornero
DB_USERNAME=hornero
DB_PASSWORD=hornero

# Usadas por el servicio postgres en docker-compose.yml
POSTGRES_DB=hornero
POSTGRES_USER=hornero
POSTGRES_PASSWORD=hornero
