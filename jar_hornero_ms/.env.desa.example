# ── .env.desa — local dev conectado a Railway ─────────────────────────────────
# Uso: cp .env.desa.example .env.desa  →  completar con los valores de Railway
# Arranca el MS:  make dev-ms-desa   (terminal 1)
# Arranca el BFF: make dev-bff-desa  (terminal 2)
# Arranca la App: make dev-app-desa  (terminal 3)
# No es necesario correr postgres-up — la DB vive en Railway.

# Shared — debe coincidir con el JWT_SECRET configurado en Railway
JWT_SECRET=REEMPLAZAR

# MS
SERVER_PORT=8081

# BFF
PORT=3001
JAVA_MS_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000

# App
NEXT_PUBLIC_BFF_URL=http://localhost:3001

# Database — Railway (obtené estos valores en: Railway → tu proyecto → Variables)
DB_HOST=REEMPLAZAR
DB_PORT=REEMPLAZAR
DB_NAME=REEMPLAZAR
DB_USERNAME=REEMPLAZAR
DB_PASSWORD=REEMPLAZAR
