meta {
  name: Crear necesidad
  type: http
  seq: 2
}

post {
  url: {{bffUrl}}/necesidades
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: access_token={{accessToken}}
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "descripcion": "Necesitamos ropa de abrigo talle adulto",
    "prioridad": "URGENTE",
    "fechaVencimiento": "2026-08-01"
  }
}

docs {
  Protected — referente only. Creates a need linked to the authenticated
  referente's organization. `prioridad` values: URGENTE | MEDIA | NORMAL.
  `fechaVencimiento` is optional (ISO 8601 date string).
}
