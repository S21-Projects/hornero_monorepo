meta {
  name: Actualizar necesidad
  type: http
  seq: 4
}

patch {
  url: {{bffUrl}}/necesidades/{{necesidadId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: access_token={{accessToken}}
}

body:json {
  {
    "descripcion": "Necesitamos ropa de abrigo talle adulto y niño",
    "prioridad": "MEDIA",
    "estado": "ACTIVA",
    "fechaVencimiento": "2026-09-01"
  }
}

vars:pre-request {
  necesidadId: 1
}

docs {
  Protected — referente only. Partially updates a need. All fields are optional.
  `prioridad` values: URGENTE | MEDIA | NORMAL.
}
