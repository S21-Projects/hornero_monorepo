meta {
  name: Actualizar estado donacion
  type: http
  seq: 5
}

patch {
  url: {{bffUrl}}/donaciones/{{donacionId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: access_token={{accessToken}}
}

body:json {
  {
    "estado": "EN_CAMINO"
  }
}

vars:pre-request {
  donacionId: 1
}

docs {
  Protected — donante only. Drives a donation forward from ACEPTADA/EN_CAMINO.
  Legal `estado` targets: EN_CAMINO | CANCELADA. The referente's ACEPTADA/RECHAZADA
  decision is now a separate endpoint — see `decidir.bru`.
}
