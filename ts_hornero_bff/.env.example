# -------------------------------------------------------
# ts_hornero_bff — environment template
# Copy to .env and fill in values for local dev.
# DO NOT commit .env.
# -------------------------------------------------------

# URL of the Spring Boot microservice
JAVA_MS_URL=http://localhost:8081

# Port this BFF listens on
PORT=3001

# Allowed CORS origin (the Next.js frontend URL)
FRONTEND_URL=http://localhost:3000

# Node environment (development | production)
NODE_ENV=development

# Railway Object Storage (t3.storageapi.dev)
# Get these from the Railway dashboard → Object Storage → S3-compatible Credentials
AWS_ENDPOINT_URL=https://t3.storageapi.dev
AWS_S3_BUCKET_NAME=allocated-breadbox-ruihj
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
